# 强制 GitHub 将本项目的语言标签显示为 Ruby
* linguist-language=Ruby

# Ruby 源文件
*.rb linguist-language=Ruby

# Shell 脚本按照Ruby统计，为了解决Ruby小于50%导致WaveProxy被误判为Shell项目的问题
*.sh linguist-language=Ruby

# 配置文件同上
*.txt linguist-language=Ruby

# Markdown 文档归为文档
*.md linguist-documentation

# 忽略临时文件和编辑器备份
*.swp linguist-generated
*.swo linguist-generated
*~ linguist-generated
.DS_Store linguist-generated
